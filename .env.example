# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/bizfinder"

# JWT Secret (generate a strong random string)
JWT_SECRET="your-strong-random-secret-here"

# Resend Email API
RESEND_API_KEY="re_xxxxxxxxxxxx"
FROM_EMAIL="BizFinder <noreply@yourdomain.com>"

# Apify Actor ID (the actor you built)
# Format: username/actor-name or just the actor ID
APIFY_ACTOR_ID="your-username/your-actor-name"
